# Copy this file to .env (same folder) and fill in your key to turn on Magic Plan for uploaded drawings.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Product sample pictures (the Sample tab). Claude doesn't make images, so this uses an image
# model: a Gemini key from https://aistudio.google.com/apikey (recommended), or an OpenAI key.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# Optional: a newer model name, e.g. GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Where projects saved for the team are kept (default: apps/server/data). Online: /var/data.
# DATA_DIR=
